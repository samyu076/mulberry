# --- App ---
APP_ENV=development

# --- Database ---
# SQLite by default: free, zero setup, no external account. Swap to a
# PostgreSQL URL later for production without changing any code.
DATABASE_URL=sqlite:///./mulberrycare.db

# --- Auth ---
# Generate your own random string for local dev, e.g.: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---
DISEASE_MODEL_CONFIDENCE_THRESHOLD=0.70

# --- Third-party (add only when actually used) ---
WEATHER_API_KEY=
